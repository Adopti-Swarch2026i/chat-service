# Variables consumidas por chat-service. Fuente única de verdad para
# Docker Compose (cargado vía env_file en Compose/docker-compose.yml).
#
# Spring Boot mapea SPRING_RABBITMQ_* a spring.rabbitmq.* (relaxed binding)
# y CORS_ALLOWED_ORIGINS a cors.allowed-origins.
#
# Para correr el servicio FUERA de Docker:
#   - SPRING_RABBITMQ_HOST=localhost
#   - FIREBASE_CREDENTIALS_PATH=src/main/resources/<json>

SERVER_PORT=8081

# ── Firebase Admin ─────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
JWT_ISSUER_URI=https://securetoken.google.com/your-firebase-project-id
# El compose monta el JSON en /app/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# ── CORS — orígenes permitidos ─────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8080,http://10.0.2.2

# ── RabbitMQ ───────────────────────────────────────
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=adopti
SPRING_RABBITMQ_PASSWORD=rabbitmq_secret
