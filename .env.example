SERVER_PORT=8081
FIREBASE_PROJECT_ID=adoptiswarch-dc4da
JWT_ISSUER_URI=https://securetoken.google.com/adoptiswarch-dc4da
# Local: JSON de Firebase Admin SDK en src/main/resources/
FIREBASE_CREDENTIALS_PATH=src/main/resources/adoptiswarch-dc4da-firebase-adminsdk-fbsvc-21e2ea6cae.json
# Docker: montar el JSON como volumen
# FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
# CORS — orígenes permitidos. Spring Boot mapea CORS_ALLOWED_ORIGINS a la
# propiedad cors.allowed-origins (relaxed binding).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8080,http://10.0.2.2

# RabbitMQ — usado por ChatEventPublisher para emitir chat.message.sent.
# En docker-compose se inyecta automáticamente; solo aplica para ejecución local.
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=adopti
SPRING_RABBITMQ_PASSWORD=rabbitmq_secret
